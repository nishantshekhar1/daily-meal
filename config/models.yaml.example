# LLM role → endpoint configuration (Ollama OpenAI-compatible API)
# Copy to config/models.yaml if needed. Default targets local Ollama.

ollama_host: "127.0.0.1"

roles:
  # ── Reasoning ─────────────────────────────────────────────────────────────
  # Meal planning agent (tool calling).
  reasoning:
    base_url: "http://{ollama_host}:11434/v1"
    model: "qwen3.6:35b"
    api_key: "ollama"
    max_tokens: 4096
    temperature: 0.4

  # ── Vision (ingredient photos) ────────────────────────────────────────────
  vision:
    base_url: "http://{ollama_host}:11434/v1"
    model: "qwen3-vl:8b"
    api_key: "ollama"
    max_tokens: 1024
    temperature: 0.1

  # ── OCR (receipts) ────────────────────────────────────────────────────────
  # No PaddleOCR in Ollama — reuse the vision VL model with an OCR prompt.
  ocr:
    base_url: "http://{ollama_host}:11434/v1"
    model: "qwen3-vl:8b"
    api_key: "ollama"
    max_tokens: 2048
    temperature: 0.0

  # ── Embeddings ────────────────────────────────────────────────────────────
  embedding:
    base_url: "http://{ollama_host}:11434/v1"
    model: "nomic-embed-text"
    api_key: "ollama"
    dimensions: 768

# ── Household preferences ───────────────────────────────────────────────────
preferences:
  # Cuisines in descending preference order. The planner asks the model to
  # tag each shortlisted dish with a cuisine, then re-ranks deterministically
  # by this order. Anything not listed ranks last.
  cuisine_priority:
    - indian
    - mexican
    - italian

  # How many recipes a plan contains. Each one costs a full LLM generation,
  # so this is the single biggest lever on planning time.
  max_suggestions: 3

# ── Feature flags ───────────────────────────────────────────────────────────
features:
  web_search: false
  searxng_url: "http://localhost:8080"
  web_search_timeout_s: 8

  # Generate the current slot's suggestions in the background so opening the
  # app shows a plan immediately instead of waiting on the model.
  prewarm_suggestions: true
  # How often the background worker re-checks that the cache is warm.
  prewarm_interval_s: 300

# ── Application ─────────────────────────────────────────────────────────────
app:
  db_url: "sqlite:///./data/daily_meal.db"
  upload_dir: "./uploads"
  low_stock_threshold_pct: 15
  planning_session_ttl_s: 3600
