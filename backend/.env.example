# Which model configuration to load. The default is tuned for the 2x4090 box.
# Swap in a profile from config/profiles/ to run on a single smaller GPU —
# see config/profiles/README.md for what each tier uses and what it costs.
CONFIG_PATH=../config/models.yaml
# CONFIG_PATH=../config/profiles/24gb.yaml   # single RTX 4090 / 3090
# CONFIG_PATH=../config/profiles/16gb.yaml   # RTX 4060 Ti 16GB / 4070 Ti Super
# CONFIG_PATH=../config/profiles/12gb.yaml   # RTX 3060 12GB / 4070
# CONFIG_PATH=../config/profiles/8gb.yaml    # RTX 3070 / laptop, best-effort

DATA_DIR=./data
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO

# Only needed when features.web_search is true and the provider is "tavily".
# Get a key at https://app.tavily.com (free tier: 1000 credits/month).
TAVILY_API_KEY=
